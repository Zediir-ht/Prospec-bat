# Expéditeur
SENDER_FIRSTNAME=Corentin
SENDER_LASTNAME=MAYRAND
SENDER_EMAIL=corentin.mayrand@gmail.com
SENDER_WEBSITE=https://zdrdev.fr
SENDER_PHONE=
# Mentions légales de l'expéditeur (obligatoires en prospection B2B)
SENDER_LEGAL=ZDR Dev - SIRET XXXXXXXXXXXXXX - adresse postale

# Gmail : mot de passe d'application (compte Google > Sécurité > Validations en 2 étapes > Mots de passe d'application)
GMAIL_APP_PASSWORD=

# Rédaction des mails par Claude. Avec une clé API (console.anthropic.com, quelques centimes/mois), les mails
# sont écrits automatiquement. Sans clé : onglet « À rédiger » du dashboard (copier/coller dans claude.ai).
ANTHROPIC_API_KEY=

# review = vous validez dans le dashboard | draft = brouillons Gmail | send = envoi direct
SEND_MODE=review
DAILY_LIMIT=10
FOLLOWUP_DAYS=7

# Dashboard web
DASHBOARD_PASSWORD=choisir-un-mot-de-passe-long
DASHBOARD_SECRET=chaine-aleatoire-longue
# Jeton secret pour le déclenchement quotidien (URL /cron/<jeton>)
CRON_TOKEN=chaine-aleatoire
QUALIFY_PER_DAY=150

# Facultatif : Google Places (console.cloud.google.com, carte bancaire requise, crédit gratuit mensuel) pour
# trouver le site officiel de chaque entreprise de façon fiable au lieu de la recherche web.
GOOGLE_PLACES_KEY=

# Mode collecte : nombre maximum d'entreprises testées par collecte (bouton « Lancer la collecte »)
COLLECT_MAX=1000

# Recherche en parallèle : nombre d'entreprises testées en même temps
WORKERS=20
# Délai minimum (secondes) entre deux recherches web, tous fils confondus (ralentit seul en cas de refus)
SEARCH_INTERVAL=1.0
